# === NextAuth ===
# سر تشفير الجلسات — ولّده بـ: openssl rand -base64 32
NEXTAUTH_SECRET=
# لازم يت set في الإنتاج (دومين الموقع)
NEXTAUTH_URL=

# === RouteMisr API (Server-side) ===
# قاعدة الـ API (تُستخدم في Server Actions)
API=https://ecommerce.routemisr.com/api/v1/
# الأصل الأساسي للـ API (تُستخدم في بروكسي /api/ext)
API_ORIGIN=https://ecommerce.routemisr.com

# === الموقع العام (للـ sitemap و Open Graph) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
